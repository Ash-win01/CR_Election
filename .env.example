NODE_ENV=production
SESSION_SECRET=put-a-long-random-string-here

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cr_election

# ---- DAuth ----
DAUTH_CLIENT_ID=
DAUTH_CLIENT_SECRET=
# Must match EXACTLY what is registered in DAuth
DAUTH_CALLBACK_URL=https://your-app.vercel.app/auth/delta/callback
DAUTH_AUTHORIZE_URL=https://auth.delta.nitt.edu/authorize
DAUTH_TOKEN_URL=https://auth.delta.nitt.edu/api/oauth/token
DAUTH_USERINFO_URL=https://auth.delta.nitt.edu/api/resources/user
DAUTH_SCOPE=openid email profile user
# Field in the user response that has the roll no (the part before "@" is used)
DAUTH_ROLL_FIELD=email

# ---- Election ----
VOTING_START=2026-11-24T09:00:00+05:30
VOTING_END=2026-11-24T17:00:00+05:30
RESULTS_REFRESH_SECONDS=30